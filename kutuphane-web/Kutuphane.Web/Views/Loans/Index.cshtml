@model IEnumerable<LoanDto>
@{
    ViewData["Title"] = "Ödünç İşlemleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Ödünç İşlemleri</h1>
    <a class="btn btn-primary" asp-action="Borrow">+ Kitap Ödünç Ver</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Kitap</th>
                    <th>Üye</th>
                    <th>Veriliş</th>
                    <th>Son İade</th>
                    <th>Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    var overdue = !loan.IsReturned && loan.DueDate < DateTime.UtcNow;
                    <tr>
                        <td>@loan.BookTitle</td>
                        <td>@loan.MemberName</td>
                        <td>@loan.LoanDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>@loan.DueDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (loan.IsReturned)
                            {
                                <span class="badge bg-success">İade edildi</span>
                            }
                            else if (overdue)
                            {
                                <span class="badge bg-danger">Gecikmiş</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Ödünçte</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!loan.IsReturned)
                            {
                                <form asp-action="Return" asp-route-id="@loan.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">İade Al</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">Henüz ödünç kaydı yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
