@model MemberDto
@{
    ViewData["Title"] = "Üyeyi Sil";
}

<h1 class="h3 mb-3">Üyeyi Sil</h1>

<div class="alert alert-danger">
    <strong>@Model.FullName</strong> adlı üyeyi silmek istediğinize emin misiniz?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
</form>
