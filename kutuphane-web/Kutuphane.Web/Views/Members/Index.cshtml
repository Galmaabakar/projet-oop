@model IEnumerable<MemberDto>
@{
    ViewData["Title"] = "Üyeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Üyeler</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni Üye</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th class="text-center">Aktif Ödünç</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td>@member.FullName</td>
                        <td>@member.Email</td>
                        <td>@(string.IsNullOrEmpty(member.Phone) ? "-" : member.Phone)</td>
                        <td class="text-center"><span class="badge bg-secondary">@member.ActiveLoanCount</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@member.Id">Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@member.Id">Sil</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">Henüz üye yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
