@model IEnumerable<BookDto>
@{
    ViewData["Title"] = "Kitaplar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kitaplar</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni Kitap</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Yıl</th>
                    <th class="text-center">Mevcut / Toplam</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td><span class="badge bg-secondary">@book.CategoryName</span></td>
                        <td>@book.PublishedYear</td>
                        <td class="text-center">
                            <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                                @book.AvailableCopies / @book.TotalCopies
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@book.Id">Detay</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@book.Id">Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@book.Id">Sil</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">Henüz kitap yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
