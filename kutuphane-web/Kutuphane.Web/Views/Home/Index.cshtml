@model DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Kütüphane Yönetim Sistemi</h1>
    <a class="btn btn-primary" asp-controller="Loans" asp-action="Borrow">+ Kitap Ödünç Ver</a>
</div>

@if (Model.ApiUnavailable)
{
    <div class="alert alert-warning">
        API'ye ulaşılamıyor. Lütfen <strong>Kutuphane.Api</strong> projesinin çalıştığından emin olun.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <div class="display-6">@Model.BookCount</div>
                    <div>Kitap</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <div class="display-6">@Model.CategoryCount</div>
                    <div>Kategori</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <div class="display-6">@Model.MemberCount</div>
                    <div>Üye</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card text-dark bg-warning h-100">
                <div class="card-body">
                    <div class="display-6">@Model.ActiveLoanCount</div>
                    <div>Aktif Ödünç</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Kitaplar</span>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Index">Tümünü gör</a>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Yazar</th>
                        <th>Kategori</th>
                        <th class="text-center">Mevcut / Toplam</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td><span class="badge bg-secondary">@book.CategoryName</span></td>
                            <td class="text-center">
                                <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                                    @book.AvailableCopies / @book.TotalCopies
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Books.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">Henüz kitap yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
