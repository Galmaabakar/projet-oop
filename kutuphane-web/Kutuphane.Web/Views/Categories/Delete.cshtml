@model CategoryDto
@{
    ViewData["Title"] = "Kategoriyi Sil";
}

<h1 class="h3 mb-3">Kategoriyi Sil</h1>

<div class="alert alert-danger">
    <strong>@Model.Name</strong> kategorisini silmek istediğinize emin misiniz?
    @if (Model.BookCount > 0)
    {
        <div class="mt-2">
            Not: Bu kategoride @Model.BookCount kitap var. İçinde kitap olan kategori silinemez.
        </div>
    }
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
</form>
