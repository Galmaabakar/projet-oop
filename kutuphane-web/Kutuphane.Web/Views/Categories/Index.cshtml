@model IEnumerable<CategoryDto>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kategoriler</h1>
    <a class="btn btn-primary" asp-action="Create">+ Yeni Kategori</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th class="text-center">Kitap Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td class="text-center"><span class="badge bg-secondary">@category.BookCount</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Sil</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">Henüz kategori yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
